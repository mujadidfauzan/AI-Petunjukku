APP_NAME="Petunjukku AI Service"
APP_ENV="development"
APP_PORT=8000

# Wajib dikirim NestJS sebagai header:
# X-Internal-API-Key: change-this-internal-key
INTERNAL_API_KEY="change-this-internal-key"

LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
KINA_LLM_MODEL="qwen/qwen3-coder-flash"
KINA_SOLVER_MODEL="qwen/qwen3-coder-flash"
KINA_EVALUATOR_MODEL="qwen/qwen3-coder-flash"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Default local deterministic embedding agar service tetap jalan untuk MVP.
# Ganti ke openrouter jika ingin memakai OpenRouter embeddings.
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

FAISS_INDEX_PATH="app/data/vector_store/cp.index"
FAISS_METADATA_PATH="app/data/vector_store/cp_metadata.json"
REQUEST_TIMEOUT_SECONDS=60
