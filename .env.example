APP_NAME="Petunjukku AI Service"
APP_ENV="development"
APP_PORT=8000

# Wajib dikirim NestJS sebagai header:
# X-Internal-API-Key: change-this-internal-key
INTERNAL_API_KEY="change-this-internal-key"

LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY=""
LLM_MODEL="google/gemini-2.5-flash"
RPP_GENERATION_MODEL="deepseek/deepseek-v4-pro"
KINA_LLM_MODEL="deepseek/deepseek-v4-flash"
KINA_SOLVER_MODEL="deepseek/deepseek-v4-flash"
KINA_SUGGESTION_MODEL="openai/gpt-4o-mini"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER="openrouter"
EMBEDDING_MODEL_NAME="google/gemini-embedding-2-preview"
EMBEDDING_DIMENSION=1536
CP_PDF_PATH="../../rag/data/Kepka_BSKAP_No_01k17e8396ajn15j3hcw0k773b.pdf"
LOCAL_VECTOR_INDEX_PATH="app/data/vector_store/local_vector_index.json"

FAISS_INDEX_PATH="app/data/vector_store/cp.index"
FAISS_METADATA_PATH="app/data/vector_store/cp_metadata.json"
REQUEST_TIMEOUT_SECONDS=60
