APP_NAME="Petunjukku AI Service"
APP_ENV="development"
APP_PORT=8000

# Wajib dikirim NestJS sebagai header:
# X-Internal-API-Key: change-this-internal-key
INTERNAL_API_KEY="change-this-internal-key"

LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY=""
LLM_MODEL="qwen/qwen3.7-plus"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=12000

# Default local deterministic embedding agar service tetap jalan untuk MVP.
# Ganti ke openrouter jika ingin memakai OpenRouter embeddings.
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

FAISS_INDEX_PATH="app/data/vector_store/cp.index"
FAISS_METADATA_PATH="app/data/vector_store/cp_metadata.json"
REQUEST_TIMEOUT_SECONDS=180

# Resource discovery otomatis untuk sumber belajar Stage 3.
RESOURCE_DISCOVERY_ENABLED=true
RESOURCE_DISCOVERY_TIMEOUT_SECONDS=15
RESOURCE_DISCOVERY_MAX_RESULTS=5
YOUTUBE_API_KEY=""
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"

# Endpoint katalog yang digunakan situs resmi SIBI Kemendikdasmen.
BOOK_CATALOG_API_URL="https://api.buku.cloudapp.web.id/api/catalogue/getPenggerakTextBooks"
BOOK_CATALOG_ALLOWED_DOMAINS="buku.kemendikdasmen.go.id,static.sc.cloudapp.web.id,static-sc.cloudapp.web.id,files.cloudapp.web.id"
